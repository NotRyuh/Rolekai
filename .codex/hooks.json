{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-continuity.cjs\" hook --runtime codex",
            "commandWindows": "powershell.exe -NoProfile -Command \"node ((git rev-parse --show-toplevel) + '/scripts/agent-continuity.cjs') hook --runtime codex\"",
            "timeout": 5
          }
        ]
      }
