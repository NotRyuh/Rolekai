# Local development placeholders. Replace the password consistently; never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql://rolekai:replace-with-a-random-local-password@127.0.0.1:15432/rolekai
TEST_DATABASE_URL=postgresql://rolekai:replace-with-a-random-local-password@127.0.0.1:15432/rolekai_foundation_test
DATABASE_CONNECT_TIMEOUT_SECONDS=2
CURRENT_OWNER_ID=00000000-0000-0000-0000-000000000001
API_ACCESS_TOKEN=replace-with-a-random-local-token
GREENHOUSE_BOARDS=[]
MANUAL_FETCH_HOSTS=[]
REMOTIVE_QUERIES_PER_DAY=4
